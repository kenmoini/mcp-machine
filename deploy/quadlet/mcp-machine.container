# Quadlet unit for MCP Machine.
#
# Rootful (default): install to /etc/containers/systemd/ (sudo make quadlet-install)
# and make sure the Podman socket is active: systemctl enable --now podman.socket
#
# Rootless: install to ~/.config/containers/systemd/, change the socket Volume
# below to  Volume=%t/podman/podman.sock:/run/podman/podman.sock  and run
# systemctl --user enable --now podman.socket
# and  sudo loginctl enable-linger $USER  so the user's units start at boot and
# keep running after logout.
#
# Two host directories are mounted:
#   /etc/mcp-machine  (read-only) holds the admin files: config.yaml and
#                     optional drop-ins in config.d/*.yaml. It must exist and
#                     contain config.yaml (start from config.example.yaml).
#   /srv/mcp-machine  -> /data (writable) holds UI-owned state; the web UI writes
#                     the servers it adds or edits to /srv/mcp-machine/config.d/
#                     <name>.yaml, one file per server. It must exist.
# Secrets referenced as ${VAR} in the config files can be supplied with
# EnvironmentFile=/etc/mcp-machine.env or Environment=NAME=value lines.
[Unit]
Description=MCP Machine
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/kenmoini/mcp-machine:latest
ContainerName=mcp-machine
PublishPort=8080:8080
Volume=/run/podman/podman.sock:/run/podman/podman.sock
Volume=/etc/mcp-machine:/etc/mcp-machine:ro
Volume=/srv/mcp-machine:/data
Network=mcp-machine.network
SecurityLabelDisable=true
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
